# Serves the app from /zoombackgroundgenerator/ on the domain.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html/zoombackgroundgenerator
COPY docker/nginx.subpath.conf /etc/nginx/conf.d/default.conf
